GLIDERD_ARGS="--node-id=CHANGE_ME --cluster-id=CHANGE_ME --etcd-endpoints=https://etcd-1:2379,https://etcd-2:2379,https://etcd-3:2379 --etcd-tls-cert=/etc/glider/pki/node-etcd.crt --etcd-tls-key=/etc/glider/pki/node-etcd.key --etcd-ca=/etc/glider/pki/etcd-ca.crt --etcd-tls-server-name=etcd.glider.internal --data-dir=/var/lib/glider --network-cidr=10.64.0.0/24 --operations-listen=0.0.0.0:9443 --tls-cert=/etc/glider/pki/node.crt --tls-key=/etc/glider/pki/node.key --client-ca=/etc/glider/pki/ca.crt --exec-helper=/usr/libexec/glider/glider-exec"
