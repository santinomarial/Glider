GLIDER_BACKUP_ARGS="--endpoint=https://etcd-1:2379 --key-file=/etc/glider/backup.key --tls-cert=/etc/glider/pki/etcd-client.crt --tls-key=/etc/glider/pki/etcd-client.key --ca=/etc/glider/pki/etcd-ca.crt --tls-server-name=etcd.glider.internal --timeout=10m"
GLIDER_BACKUP_KEY_FILE="/etc/glider/backup.key"
GLIDER_BACKUP_RETENTION_DAYS="30"
